{
  "name": "svelte_starter_kit",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint '*.{js,mjs,cjs,ts}' app/javascript/ --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint '*.{js,mjs,cjs,ts}' app/javascript/ --fix",
    "format": "prettier --check 'app/javascript' '*.{js,mjs,cjs,ts}'",
    "format:fix": "prettier --write 'app/javascript' '*.{js,mjs,cjs,ts}'"
  },
  "dependencies": {
    "@inertiajs/svelte": "^3.7.1",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@inertiajs/core": "^3.7.1",
    "@inertiajs/vite": "^3.7.1",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.48.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rails-vite-plugin": "^0.2.5",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}
